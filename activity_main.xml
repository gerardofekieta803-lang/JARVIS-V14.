    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="JARVIS V14" android:textColor="#00FFFF" android:textSize="22sp" android:gravity="center"/>
    <Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="60dp" android:text="JARVIS ON" android:layout_marginTop="12dp"/>
    <TextView android:id="@+id/txtLog" android:layout_width="match_parent" android:layout_height="match_parent" android:text="Ready" android:textColor="#00FF00" android:background="#111111" android:layout_marginTop="8dp"/>
</LinearLayout>
